# Copy this file to `.env` (or `.env.production` for the deployed build) and fill in
# your Supabase project values. Both are safe to expose in a static frontend:
# the anon key is public by design — Row-Level Security (see supabase/schema.sql)
# is what actually protects the data.
#
# Find these in your Supabase project: Settings → API Keys (anon/public key) and
# Settings → Data API (Project URL).
# If these are left unset, the site still works — analytics tracking just no-ops.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
